#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# NeoSymbian telephony C1: RAM-only Linux reference (docs/telephony.md). Never mounts or writes the eMMC; the modem's
# EFS comes from RAM copies of the C0 backup (rmtfs -o, -r keeps its writes in RAM).
export PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc; mount -t sysfs sys /sys; mount -t devtmpfs dev /dev
mkdir -p /dev/pts /run /tmp /var/log; mount -t devpts devpts /dev/pts; mount -t tmpfs tmpfs /run
mount -t configfs none /sys/kernel/config; mount -t debugfs none /sys/kernel/debug
exec >/var/log/init.log 2>&1
set -x
hostname c1-bonito
(sleep 7200; echo 'C1: 2 h up, rebooting'; reboot -f) &	# no watchdog here: never leave the phone stuck in Linux
udevd --daemon; udevadm trigger --action=add; udevadm settle -t 30
# USB: ECM network 172.16.42.1 + ACM shell on ttyGS0 (udhcpd did not answer the Mac on 2026-11-08: set .2 by hand)
modprobe libcomposite; modprobe usb_f_ecm; modprobe usb_f_acm
for i in $(seq 1 30); do [ -n "$(ls /sys/class/udc 2>/dev/null)" ] && break; sleep 1; done
G=/sys/kernel/config/usb_gadget/g1; mkdir -p $G/strings/0x409 $G/configs/c.1/strings/0x409 $G/functions/ecm.usb0 $G/functions/acm.GS0
echo 0x18d1 > $G/idVendor; echo 0xd001 > $G/idProduct
echo c1-bonito > $G/strings/0x409/serialnumber; echo NeoSymbian > $G/strings/0x409/manufacturer; echo "C1 Linux reference" > $G/strings/0x409/product
echo ecm+acm > $G/configs/c.1/strings/0x409/configuration
ln -s $G/functions/ecm.usb0 $G/configs/c.1/; ln -s $G/functions/acm.GS0 $G/configs/c.1/
ls /sys/class/udc | head -1 > $G/UDC
sleep 2; ip addr add 172.16.42.1/24 dev usb0; ip link set usb0 up
udhcpd /etc/udhcpd.conf
mkdir -p /etc/dropbear; dropbear -R -B -E
telnetd -l /bin/sh
(while true; do setsid sh -c 'exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1'; sleep 1; done) &
# modem: kernel qrtr-ns + pd-mapper; rmtfs (RAM copies, starts the MSS) and tqftpserv
mkdir -p /var/lib/tqftpserv /run/dbus
tqftpserv > /var/log/tqftpserv.log 2>&1 &
rmtfs -r -o /var/lib/rmtfs -s -v > /var/log/rmtfs.log 2>&1 &
dbus-daemon --system --nofork --nopidfile > /var/log/dbus.log 2>&1 &
sleep 1
/usr/lib/polkit-1/polkitd --no-debug > /var/log/polkit.log 2>&1 &
sleep 1
ModemManager --debug > /var/log/mm.log 2>&1 &
(sleep 20; mmcli -m 0 -e > /var/log/mm-enable.log 2>&1; autoanswer > /var/log/autoanswer.log 2>&1) &
q6voiced hw:0,4 > /var/log/q6voiced.log 2>&1 &
voice-route > /var/log/voice-route.log 2>&1
echo C1 init done
while true; do sleep 3600; done
